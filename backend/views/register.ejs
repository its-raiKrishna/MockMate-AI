<!DOCTYPE html>
<html>
<head>

    <title>Register - MockMate</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" href="https://cdn-icons-png.flaticon.com/512/4712/4712109.png">

</head>

<body class="bg-black flex items-center justify-center min-h-screen text-white">

    <div class="bg-gray-900 p-8 rounded-xl w-96">

        <h2 class="text-2xl font-bold mb-6 text-center">Register</h2>

        <form action="/register" method="POST">

            <input type="text" name="name" placeholder="Full Name" class="w-full p-3 mb-4 rounded bg-gray-800" required>

            <input type="email" name="email" placeholder="Email" class="w-full p-3 mb-4 rounded bg-gray-800" required>

            <input type="password" name="password" placeholder="Password" class="w-full p-3 mb-6 rounded bg-gray-800"
                required>

            <button class="w-full bg-indigo-600 py-3 rounded hover:bg-indigo-500">
                Register
            </button>

        </form>

        <p class="text-center mt-4 text-gray-400">
            Already have an account?
            <a href="/login" class="text-indigo-400">Login</a>

        </p>

    </div>

</body>

</html>