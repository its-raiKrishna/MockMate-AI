<!DOCTYPE html>
<html>

<head>

<title>Interview - MockMate</title>

<script src="https://cdn.tailwindcss.com"></script>

<link rel="icon" href="https://cdn-icons-png.flaticon.com/512/4712/4712109.png">

</head>

<body class="bg-black text-white min-h-screen flex flex-col items-center justify-center">

<a href="/" class="bg-gray-800 px-4 py-2 rounded-lg hover:bg-gray-700 mb-6">
Go to HomePage
</a>

<h1 class="text-4xl font-bold mb-10">
Mock Interview Session
</h1>

<div class="bg-gray-900 p-8 rounded-xl max-w-xl w-full text-center">

<h2 class="text-xl mb-4">
Question:
</h2>

<p id="questionText" class="text-gray-300 mb-6 text-lg">
Tell me about yourself.
</p>

<button 
id="startSpeech"
class="bg-green-600 px-6 py-3 rounded-lg hover:bg-green-500 mt-4">
🎤 Answer Question
</button>

<p id="statusText" class="text-gray-400 mt-6">
Click the button and speak your answer.
</p>

</div>

<script>

const button = document.getElementById("startSpeech");
const statusText = document.getElementById("statusText");

const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
const recognition = new SpeechRecognition();

recognition.lang = "en-US";

button.onclick = () => {

statusText.innerText = "Listening... Speak now.";

recognition.start();

};

recognition.onresult = (event) => {

const transcript = event.results[0][0].transcript;

console.log("User Answer:", transcript);

statusText.innerText = "Answer received.";

};

// AI speaks question

function speakQuestion(){

const question = document.getElementById("questionText").innerText;

const speech = new SpeechSynthesisUtterance(question);

speech.lang = "en-US";

window.speechSynthesis.speak(speech);

}

window.onload = speakQuestion;

</script>

</body>

</html>