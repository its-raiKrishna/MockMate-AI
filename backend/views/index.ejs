<!DOCTYPE html>
<html>

<head>
    <title>MockMate AI</title>
    <link rel="icon" href="https://cdn-icons-png.flaticon.com/512/4712/4712109.png">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-black text-white">

    <!--------------------------------- NAVBAR ------------------------------------------------>

    <nav class="flex justify-between items-center px-20 py-5">
        <div class="flex items-center gap-3">
            <img src="https://cdn-icons-png.flaticon.com/512/4712/4712109.png" width="40">
            <h2 class="text-xl font-semibold">MockMate AI</h2>

        </div>
        <div class="flex items-center gap-8 text-gray-300">
            <a href="/" class="hover:text-white">Home</a>
            <a href="/interview" class="hover:text-white">Interview</a>
            <a href="#" class="hover:text-white">Results</a>
        </div>

    </nav>



    <!------------------------- HERO SECTION ------------------------------->

    <section class="flex justify-between items-center px-20 py-20">

        <div class="max-w-xl">
            <h1 class="text-5xl font-bold mb-6">
                Get Interview-Ready with AI Powered Practice
            </h1>

            <p class="text-gray-400 mb-6">
                Practice real interview questions, get instant AI feedback,
                and improve your confidence before the real interview.
            </p>

            <a href="/interview">
                <button class="bg-indigo-600 px-6 py-3 rounded-lg hover:bg-indigo-500">
                    Start an Interview
                </button>
            </a>

        </div>


        <div>

            <img src="https://cdn-icons-png.flaticon.com/512/4712/4712109.png" width="220">

        </div>

    </section>



    <!-------------- TAKE INTERVIEWS ---------------------------->

    <section class="px-20 py-10">

        <h2 class="text-2xl font-semibold mb-8">

            Take Interviews
            <hr>

        </h2>


        <div class="grid grid-cols-3 gap-8">

            <!---------------------------- CARD ------------------------>

            <div class="bg-gray-900 p-6 rounded-xl border border-gray-700">

                <h3 class="text-lg font-semibold mb-2">

                    Frontend Interview

                </h3>

                <p class="text-gray-400 mb-4">

                    Practice frontend interview questions.

                </p>

                <button class="bg-indigo-600 px-5 py-2 rounded-lg hover:bg-indigo-500">

                    Start

                </button>

            </div>



            <!----------------------------- CARD ----------------------------->

            <div class="bg-gray-900 p-6 rounded-xl border border-gray-700">

                <h3 class="text-lg font-semibold mb-2">
                    Backend Interview

                </h3>

                <p class="text-gray-400 mb-4">

                    Practice Backend interview questions.

                </p>

                <button class="bg-indigo-600 px-5 py-2 rounded-lg hover:bg-indigo-500">

                    Start

                </button>

            </div>



            <!---------------------------- CARD --------------------------------->

            <div class="bg-gray-900 p-6 rounded-xl border border-gray-700">
                <h3 class="text-lg font-semibold mb-2">
                    HR Interview
                </h3>
                <p class="text-gray-400 mb-4">
                    Practice HR interview questions.
                </p>

                <button class="bg-indigo-600 px-5 py-2 rounded-lg hover:bg-indigo-500">
                    Start
                </button>

            </div>


        </div>
    </section>
</body>

</html>